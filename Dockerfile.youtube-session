FROM oven/bun:1.3.13-alpine AS yt-session-source

ARG YT_SESSION_REF=bc48b66471bf886dd7f707e4fd7fef281e87f69a

WORKDIR /opt/yt-session

RUN apk add --no-cache ca-certificates curl tar \
    && curl -fsSL \
       "https://github.com/idMJA/youtube-trusted-session-generator/archive/${YT_SESSION_REF}.tar.gz" \
       -o /tmp/yt-session.tar.gz \
    && tar -xzf /tmp/yt-session.tar.gz --strip-components=1 \
    && rm /tmp/yt-session.tar.gz

# The upstream default fans out to CPU-1 workers. A single worker is enough
# for one co-located MediaBridge session and avoids unnecessary memory use.
RUN sed -i \
      's/const generate = generateMultiThread;/const generate = generateSingleThread;/' \
      src/index.ts \
    && grep -q 'const generate = generateSingleThread;' src/index.ts \
    && sed -i \
      -e 's/"fastify": "\^5.3.2"/"fastify": "5.3.2"/' \
      -e 's/"global-agent": "\^4.1.2"/"global-agent": "4.1.2"/' \
      -e 's/"jsdom": "\^27.0.0"/"jsdom": "27.0.0"/' \
      package.json \
    && bun install --production

FROM node:24-alpine AS build
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app
COPY . /app

RUN corepack enable
RUN apk add --no-cache python3 alpine-sdk

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile

RUN pnpm deploy --filter=@imput/cobalt-api --prod /prod/api

FROM node:24-alpine AS api-youtube-session

ENV YOUTUBE_SESSION_SERVER="http://127.0.0.1:8080"
ENV YOUTUBE_SESSION_INNERTUBE_CLIENT="MWEB"
ENV YOUTUBE_SESSION_REFRESH_INTERVAL_MS="300000"

WORKDIR /app

RUN apk add --no-cache \
      ca-certificates \
      libstdc++ \
      su-exec

COPY --from=yt-session-source /usr/local/bin/bun /usr/local/bin/bun
COPY --from=yt-session-source --chown=node:node /opt/yt-session /opt/yt-session

COPY --from=build --chown=node:node /prod/api /app
COPY --from=build --chown=node:node /app/.git /app/.git
COPY docker/start-youtube-session.sh /usr/local/bin/start-youtube-session

RUN chmod 0755 /usr/local/bin/start-youtube-session

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --start-period=150s --retries=3 \
  CMD node -e "const p=process.env.API_PORT||9000; fetch('http://127.0.0.1:'+p+'/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["/usr/local/bin/start-youtube-session"]
