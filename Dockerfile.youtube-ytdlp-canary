FROM node:22.21-bookworm-slim AS bgutil-build

ARG BGUTIL_REF=37169ee2656e08c5c2e5dc9df4c598c0cb4c88a8

WORKDIR /opt/bgutil

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       g++ \
       make \
       pkg-config \
       libcairo2-dev \
       libpango1.0-dev \
       libjpeg62-turbo-dev \
       libgif-dev \
       librsvg2-dev \
    && curl -fsSL \
       "https://github.com/Brainicism/bgutil-ytdlp-pot-provider/archive/${BGUTIL_REF}.tar.gz" \
       -o /tmp/bgutil.tar.gz \
    && tar -xzf /tmp/bgutil.tar.gz --strip-components=1 \
    && rm /tmp/bgutil.tar.gz \
    && cd server \
    && npm ci \
    && npx tsc \
    && npm prune --omit=dev \
    && rm -rf /root/.npm /var/lib/apt/lists/*

FROM node:22.21-bookworm-slim AS youtube-ytdlp-canary

ENV PATH="/opt/venv/bin:$PATH"
ENV CANARY_PORT=9000
ENV YTDLP_BIN=/opt/venv/bin/yt-dlp
ENV YTDLP_EXTRACT_TIMEOUT=45
ENV YTDLP_SOCKET_TIMEOUT=20
ENV MEDIA_PROBE_TIMEOUT=20
ENV YTDLP_IMPERSONATE=chrome

WORKDIR /opt/youtube-canary

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       python3 \
       python3-venv \
       libcairo2 \
       libpango-1.0-0 \
       libjpeg62-turbo \
       libgif7 \
       librsvg2-2 \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
       "yt-dlp[default,curl-cffi]==2026.08.19" \
       "bgutil-ytdlp-pot-provider==2.0.0" \
    && rm -rf /var/lib/apt/lists/*

COPY --from=bgutil-build /opt/bgutil/server /opt/bgutil/server
COPY youtube-canary/app.py /opt/youtube-canary/app.py
COPY docker/start-ytdlp-canary.sh /usr/local/bin/start-ytdlp-canary

RUN chmod 0755 /usr/local/bin/start-ytdlp-canary \
    && useradd --create-home --uid 10001 canary \
    && chown -R canary:canary /opt/youtube-canary /opt/bgutil

USER canary

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD python3 -c "import os,urllib.request; p=os.environ.get('PORT',os.environ.get('CANARY_PORT','9000')); urllib.request.urlopen('http://127.0.0.1:'+p+'/healthz',timeout=3).read()"

CMD ["/usr/local/bin/start-ytdlp-canary"]
